# Copy this file to backend/.env (or .env in the project root) and edit the values.
# NEVER commit the real .env file.

# --- Django ---------------------------------------------------------------
# Generate a key:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# True for local development, False in production
DJANGO_DEBUG=True
# Comma separated. 10.0.2.2 lets the Android emulator reach your PC.
# Add your PC's LAN IP (e.g. 192.168.1.10) to test from a real phone.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],10.0.2.2
# Needed in production for HTTPS form posts, e.g. https://your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
CURRENCY_SYMBOL=₹

# --- Database -------------------------------------------------------------
# Optional absolute path for the SQLite file (default: backend/db.sqlite3).
# On a host with a persistent disk, point this at the disk, e.g. /var/data/db.sqlite3
# DJANGO_DB_PATH=

# --- Production only (DJANGO_DEBUG=False) ---------------------------------
# Set to False if your host terminates HTTPS and you see redirect loops.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_LOG_LEVEL=WARNING
